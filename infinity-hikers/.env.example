# Copy this file to .env and fill in your values
# In Netlify/Vercel, set these in the dashboard under Environment Variables

VITE_ADMIN_PASSWORD=infinity2026

# Supabase Storage (used for direct image uploads in the admin panel).
# Leave blank until credentials are available — uploads are disabled and
# the admin form falls back to pasting image URLs.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Storage bucket that holds tour images. Assumed name — create it in the
# Supabase dashboard (Storage > New bucket, public) or change this value.
VITE_SUPABASE_BUCKET=tour-images
