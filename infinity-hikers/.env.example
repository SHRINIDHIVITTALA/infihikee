# Copy this file to .env and fill in your values
# In Netlify/Vercel, set these in the dashboard under Environment Variables

# Supabase project credentials — power both /admin login (Supabase Auth)
# and direct image uploads (Supabase Storage). Leave blank to disable
# both: the admin login screen will show a setup message, and the tour
# image form falls back to pasting image URLs.
#
# Admin accounts are NOT created by this app — add them once in the
# Supabase dashboard under Authentication > Users > Add user.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Storage bucket that holds tour images. Must match the bucket's exact
# name in the Supabase dashboard (Storage) — mismatches fail as "Bucket
# not found" with no other indication of what went wrong.
VITE_SUPABASE_BUCKET=tour_images

# Google Analytics 4 measurement ID (looks like "G-XXXXXXXXXX"). Leave
# blank to keep analytics fully disabled — no script loads, nothing is
# tracked. Get one free at analytics.google.com: Admin > Create Property
# > Data Streams > Web > add your site URL > copy the "Measurement ID"
# shown for that stream.
VITE_GA_MEASUREMENT_ID=
