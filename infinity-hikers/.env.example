# Copy this file to .env and fill in your values
# In Netlify/Vercel, set these in the dashboard under Environment Variables

# Supabase project credentials — power both /admin login (Supabase Auth)
# and direct image uploads (Supabase Storage). Leave blank to disable
# both: the admin login screen will show a setup message, and the tour
# image form falls back to pasting image URLs.
#
# Admin accounts are NOT created by this app — add them once in the
# Supabase dashboard under Authentication > Users > Add user.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Storage bucket that holds tour images. Assumed name — create it in the
# Supabase dashboard (Storage > New bucket, public) or change this value.
VITE_SUPABASE_BUCKET=tour-images
